# Server
PORT=5000
NODE_ENV=development

# Database (SQL Server)
DATABASE_URL="sqlserver://localhost:1433;database=SarrafaDB;user=sa;password=YourPassword;trustServerCertificate=true"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CLIENT_URL=http://localhost:3000
